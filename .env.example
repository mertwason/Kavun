# Kavun — ortam değişkenleri örneği. `make dev` bu dosyadan .env üretir.
# Gerçek secret'lar .env'de tutulur ve repoya ASLA commit edilmez.

# --- Veritabanı ---
POSTGRES_USER=kavun
POSTGRES_PASSWORD=kavun
POSTGRES_DB=kavun
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://kavun:kavun@localhost:5432/kavun

# --- Redis (cache + Celery broker) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Servis portları ---
API_PORT=8000
FRONTEND_PORT=3000

# --- Uygulama ---
ENVIRONMENT=local
LOG_LEVEL=INFO

# Fernet anahtarı — store credential şifrelemesi (spec §3.6).
# Üret: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KAVUN_ENCRYPTION_KEY=

# JWT imzalama anahtarı (spec §8)
JWT_SECRET=dev-only-degistir

# --- Mağaza credential'ları (KVN-04'te DB'de şifreli saklanır; buradakiler yalnızca ilk kurulum içindir) ---
TRENDYOL_API_KEY=
TRENDYOL_API_SECRET=
TRENDYOL_SELLER_ID=

# ops.mokka SSO token doğrulaması için paylaşılan secret (spec §8)
OPS_SSO_SECRET=
