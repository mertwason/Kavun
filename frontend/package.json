{
  "name": "kavun-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint && npm run lint:design",
    "lint:design": "node tools/check-design-rules.mjs",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ${KAVUN_API_URL:-http://localhost:8000}/openapi.json -o lib/api-types.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "geist": "1.3.1",
    "lucide-react": "^1.33.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "openapi-typescript": "7.4.1",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3"
  }
}
